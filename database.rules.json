{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "classes":   { ".read": "auth != null && root.child('users/' + auth.uid).exists()", ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'Admin'" },
    "cards":     { ".read": "auth != null && root.child('users/' + auth.uid).exists()", ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'Admin'" },
    "timetable": { ".read": "auth != null && root.child('users/' + auth.uid).exists()", ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'Admin'" },
    "settings":  { ".read": "auth != null && root.child('users/' + auth.uid).exists()", ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'Admin'" },
    "meta":      { ".read": "auth != null && root.child('users/' + auth.uid).exists()", ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'Admin'" },

    "live": {
      "$cls": {
        ".read":  "auth != null && root.child('users/' + auth.uid).exists()",
        ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'Device'"
      }
    },

    "commands": {
      "$cls": {
        ".read":  "auth != null && root.child('users/' + auth.uid + '/role').val() === 'Device'",
        ".write": "auth != null && root.child('users/' + auth.uid).exists()"
      }
    },

    "history": {
      "$cls": {
        ".read":  "auth != null && root.child('users/' + auth.uid).exists()",
        ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'Device'"
      }
    }
  }
}
